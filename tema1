def transpusa(A):
    T=[
        [A[0][0], A[1][0], A[2][0]],
        [A[0][1], A[1][1], A[2][1]],
        [A[0][2], A[1][2], A[2][2]]
    ]
    return T

print("transpusa(A)=", transpusa(A))


