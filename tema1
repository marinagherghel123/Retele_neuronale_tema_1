def produs_matr(A,B):
    P= [
        A[0][0] * B[0] + A[0][1] * B[1] + A[0][2] * B[2],
        A[1][0] * B[0] + A[1][1] * B[1] + A[1][2] * B[2],
        A[2][0] * B[0] + A[2][1] * B[1] + A[2][2] * B[2]
    ]
    return P
print("produs_matr(A,B)=", produs_matr(A,B))

#Third Part

def Cramer(A,B):
    detA=determinant(A)
    Ax=[
        [B[0], A[0][1], A[0][2]],
        [B[1], A[1][1], A[1][2]],
        [B[2], A[2][1], A[2][2]]
    ]
    Ay=[[A[0][0], B[0], A[0][2]],
        [A[1][0], B[1], A[1][2]],
        [A[2][0], B[2], A[2][2]]
    ]
    Az=[
        [A[0][0], A[0][1], B[0]],
        [A[1][0], A[1][1], B[1]],
        [A[2][0], A[2][1], B[2]]
    ]
    det_Ax=determinant(Ax)
    det_Ay=determinant(Ay)
    det_Az=determinant(Az)
    x=det_Ax/detA
    y=det_Ay/detA
    z=det_Az/detA
    return x,y,z
print("Cramer(A,B)=", Cramer(A,B))

#4th part

def minor(A,linie,col):
    M=[]
    for i in range(3):
        if i!=linie:
            linie_nou=[]
            for j in range(3):
                if j!=col:
                    linie_nou.append(A[i][j])

            M.append(linie_nou)
    return M


def cofactor_matr(A):
    C=[]
    for i in range(3):
        linie=[]
        for j in range(3):
            M=minor(A,i,j)
            det_M=determinant(M)
            semn=(-1)**(i+j)
            c=semn*det_M
            linie.append(c)
        C.append(linie)
    return C
print("cofactor_matr(A)=", cofactor_matr(A))

def inversa_matr(A):
    detA=determinant(A)
    C=cofactor_matr(A)
    adj=transpusa(C)
    INV=[]
    for i in range(3):
        linie=[]
        for j in range(3):
            inv=adj[i][j]/detA
            linie.append(inv)
        INV.append(linie)
    return INV
print("inversa_matr(A)=", inversa_matr(A))

A_inv=inversa_matr(A)
X=produs_matr(A_inv,B)
print("Solutia ecuatiei X=", X)

