import math
#FIRST PART

A = []
B = []


file = open("input.txt", "r")

for line in file:
    parts = line.split()#functia asta separa textul dupa spatii


    # coeficientul lui x
    x_text = parts[0]

    if x_text == "x":
        x = 1
    else:
        x = int(x_text.replace("x", ""))

    # coeficientul lui y
    y_text = parts[2]

    if y_text == "y":
        y = 1
    else:
        y = int(y_text.replace("y", ""))

    if parts[1] == "-":
        y = -y

    # coeficientul lui z

    z_text=parts[4]

    if z_text=="z":
        z=1
    else:
        z=int(z_text.replace("z",""))

    if parts[3]=="-":
        z=-z

    # numarul din dreapta egalului
    b = int(parts[6])

    A.append([x, y, z])
    B.append(b)

file.close()

print("A =", A)
print("B =", B)

