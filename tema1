def urma(A):
    if (len(A) == 1):
        tr=A[0][0]
    if (len(A) == 2):
        tr=A[0][0]+A[1][1]
    if (len(A) == 3):
        tr=A[0][0]+A[1][1]+A[2][2]
    return tr

print("urma(A)=", urma(A))

